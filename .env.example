# PostgreSQL is provided through Docker Compose.
POSTGRES_DB=sourcepilot
POSTGRES_USER=sourcepilot
POSTGRES_PASSWORD=sourcepilot
POSTGRES_TEST_DB=sourcepilot_test

# Required by the API when it begins using persistence. It is not needed for the
# existing health-only endpoint.
DATABASE_URL=postgresql+psycopg://sourcepilot:sourcepilot@localhost:5432/sourcepilot

# Required only for persistence/integration tests and CI. Never point this at
# the database named by DATABASE_URL.
TEST_DATABASE_URL=postgresql+psycopg://sourcepilot:sourcepilot@localhost:5432/sourcepilot_test

# Anonymous demo-session behavior. The fixed lifetime defaults to 24 hours.
DEMO_SESSION_TTL_SECONDS=86400
# Keep false for local HTTP development. Set true in every HTTPS deployment.
DEMO_SESSION_COOKIE_SECURE=false

# Required only by explicit AI operations, including the manual M0-U5 smoke check.
# API startup and automated tests do not require either value.
OPENAI_API_KEY=
SOURCEPILOT_AI_MODEL=

# Optional metadata-only Langfuse tracing. Base installation needs no SDK or keys.
# Install the API observability extra only when enabling this integration.
SOURCEPILOT_LANGFUSE_ENABLED=false
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com

# PDF quote storage and validation. 10 MB means exactly 10,000,000 file bytes.
# The request limit adds 65,536 bytes for multipart framing and fields.
DOCUMENT_STORAGE_BACKEND=local
DOCUMENT_STORAGE_LOCAL_DIR=
DOCUMENT_STORAGE_S3_BUCKET=
DOCUMENT_STORAGE_S3_ENDPOINT_URL=
DOCUMENT_STORAGE_S3_REGION=
QUOTE_PDF_MAX_BYTES=10000000
QUOTE_PDF_MAX_PAGES=15
QUOTE_PDF_INSPECTION_TIMEOUT_SECONDS=10
